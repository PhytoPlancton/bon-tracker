# Copier en .env à la racine, à côté du docker-compose.yml.
# Ce fichier n'est jamais versionné (voir .gitignore).

# --- Base de données locale -------------------------------------------------
MONGO_USER=bontracker
MONGO_PASSWORD=          # au hasard, voir DEPLOIEMENT.md
MONGO_DB=bon_tracker

# --- Secrets applicatifs ----------------------------------------------------
ENCRYPTION_KEY=          # 32 octets base64 : chiffre la session leboncoin
SESSION_SECRET=          # signe le cookie de session
WORKER_TOKEN=            # partagé entre web et worker

# --- Compte d'accès à l'app -------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=     # hash bcrypt, jamais le mot de passe en clair

# --- Compte leboncoin utilisé par le collecteur -----------------------------
LBC_EMAIL=
LBC_PASSWORD=

# --- Tunnel Cloudflare ------------------------------------------------------
TUNNEL_TOKEN=            # jeton fourni à la création du tunnel

# --- Rythme de collecte -----------------------------------------------------
CRON_SCHEDULE=17 */6 * * *
