# Copier en .env à la racine, à côté du docker-compose.yml.
# Ce fichier n'est jamais versionné (voir .gitignore).
# Les valeurs sont remplies automatiquement par setup.cmd.
#
# Règle : aucun commentaire en fin de ligne. Docker Compose prendrait le
# commentaire pour une partie de la valeur.

# --- Base de données locale -------------------------------------------------
MONGO_USER=bontracker
MONGO_PASSWORD=
MONGO_DB=bon_tracker

# --- Secrets applicatifs ----------------------------------------------------
# ENCRYPTION_KEY : 32 octets en base64, chiffre la session leboncoin
# SESSION_SECRET : signe le cookie de session
# WORKER_TOKEN   : partagé entre les services web et worker
ENCRYPTION_KEY=
SESSION_SECRET=
WORKER_TOKEN=

# --- Compte d'accès à l'app -------------------------------------------------
# Le mot de passe n'est jamais stocké : seul son hash bcrypt figure ici.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Compte leboncoin utilisé par le collecteur -----------------------------
LBC_EMAIL=
LBC_PASSWORD=

# --- Tunnel Cloudflare ------------------------------------------------------
# Jeton fourni à la création du tunnel sur one.dash.cloudflare.com
TUNNEL_TOKEN=

# --- Rythme de collecte -----------------------------------------------------
CRON_SCHEDULE=17 */6 * * *
