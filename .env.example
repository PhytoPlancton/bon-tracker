# Modèle du fichier .env. En pratique, setup.cmd le remplit tout seul, ainsi
# que secrets.env qui l'accompagne. Ni l'un ni l'autre n'est versionné.
#
# Ici ne vivent que les valeurs dont Docker Compose a besoin pour construire
# docker-compose.yml. Aucune ne doit contenir de « $ » : Compose y verrait une
# variable à remplacer. Les clés et mots de passe sont dans secrets.env.

MONGO_USER=bontracker
MONGO_PASSWORD=
MONGO_DB=bon_tracker

# Jeton fourni à la création du tunnel sur one.dash.cloudflare.com
TUNNEL_TOKEN=

CRON_SCHEDULE=17 */6 * * *
